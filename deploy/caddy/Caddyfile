# deploy/caddy/Caddyfile
#
# TLS termination and public routing for the TuGPT dashboard.
#
# The web container binds 127.0.0.1:3001 on the host and is unreachable from
# anywhere else, which is correct — but it also means that after the web-only
# deployment (docs/production_environment.md section 5.4a) a reviewer cannot
# open the dashboard in a browser. This is the piece that closes that gap.
#
# Caddy rather than nginx: certificates are obtained and renewed automatically
# from Let's Encrypt with no certbot, no cron entry, and no renewal that can
# quietly stop working. The whole configuration is the twenty lines below.
#
# It is OFF by default. The compose service carries `profiles: ["proxy"]`, so
# `docker compose up -d web` does not start it and cannot start it by accident.
# Enabling it is section 5.4b.
#
# TUGPT_DOMAIN comes from /etc/tugpt/web.env via the container's env_file.
#
# The placeholder default is deliberate and is not a fallback anyone should
# rely on. With TUGPT_DOMAIN unset the site address would otherwise be empty,
# and Caddy then reads the `{` below as a global options block and fails with
# "unrecognized global option: encode" — which says nothing about the actual
# problem. The .invalid name makes the failure name itself: Caddy starts,
# refuses to obtain a certificate for it, and says so with the string
# TUGPT_DOMAIN-is-not-set in the message.
#
# Reaching `web:3000` uses the compose network directly, not the published host
# port, so this works whether or not 3001 is published and never leaves the
# Docker bridge.

{$TUGPT_DOMAIN:TUGPT_DOMAIN-is-not-set.invalid} {
	encode zstd gzip

	header {
		# The dashboard is served over HTTPS only once this is in front of it.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Caddy sets X-Forwarded-For, -Proto and -Host on its own; X-Real-IP is
	# added because it is what most log tooling expects to find.
	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# ---------------------------------------------------------------------------
# Staging (staging.tugpt.pro) — added for the Phase 3 staging environment.
#
# This block is ADDITIVE: the production site block above is unchanged,
# byte for byte. It routes the staging hostname to the staging web
# container, which runs under the separate `tugpt-staging` Compose
# project (docker-compose.staging.yml) and joins this network under the
# alias `staging-web`. Production never resolves that name; staging
# never appears in the production block.
#
# Until the staging stack exists and DNS points here, this block simply
# has no reachable upstream — it does not affect the production site.
# Caddy will try to obtain a certificate for staging.tugpt.pro once this
# configuration is loaded, so load it only after the DNS A record
# exists (see the staging hosting plan).
#
# basic_auth is the outer door for staging; the application login is
# the inner one. The hash below is a PLACEHOLDER for a discarded
# throwaway password — replace it at deploy time with the output of
# `caddy hash-password` for the real staging password, on the server,
# and never commit the real hash's plaintext anywhere.
staging.tugpt.pro {
	encode zstd gzip

	basic_auth {
		operator $2b$14$AwMrZxc1h70512BliV2mEu4YAX77XMtPkfl1q.Y64vvBMwc5.Vo/G
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	reverse_proxy staging-web:3000 {
		header_up X-Real-IP {remote_host}
	}
}
